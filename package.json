{
  "name": "chinese-diaspora-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "website"
  ],
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "tsx scripts/build-data.ts && npm run dev --workspace website",
    "build": "tsx scripts/build-data.ts && tsx scripts/clean-export.ts && npm run build --workspace website && tsx scripts/clean-placeholder.ts",
    "build:web": "npm run build --workspace website",
    "serve": "tsx scripts/serve-static.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run data:types && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:review": "tsx scripts/review-data.ts",
    "data:build": "tsx scripts/build-data.ts",
    "release:check": "tsx scripts/check-release.ts",
    "data:types": "tsx scripts/generate-types.ts",
    "dev:demo": "tsx scripts/demo.ts dev",
    "build:demo": "tsx scripts/demo.ts build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "d3-force": "3.0.0",
    "json-schema-to-ts": "3.1.1",
    "leaflet": "1.9.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-force": "3.0.10",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
