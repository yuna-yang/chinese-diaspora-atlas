# Public build configuration only. Never put secrets in NEXT_PUBLIC values.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/yuna-yang/chinese-diaspora-atlas
# Development-only, deliberately nonfunctional; action remains disabled.
NEXT_PUBLIC_REMOVAL_URL=mailto:placeholder@example.invalid
NEXT_PUBLIC_EDITORIAL_URL=mailto:placeholder@example.invalid
# Set consistently for both static build and preview/tests when verifying subpaths.
# NEXT_PUBLIC_BASE_PATH=/atlas-test
# Map-provider values may be overridden subject to its terms.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# NEXT_PUBLIC_TILE_ATTRIBUTION_TEXT=© OpenStreetMap contributors
